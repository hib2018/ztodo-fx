{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ztodo-fx.local/schemas/proposal-output-v1.json",
  "title": "ztodo-fx Proposal Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "summary",
    "completion_criteria",
    "tasks",
    "excluded",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "issue_number", "issue_title"],
      "properties": {
        "provider": { "const": "github" },
        "repository": { "type": "string", "minLength": 3, "maxLength": 200 },
        "issue_number": { "type": "integer", "minimum": 1 },
        "issue_title": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "completion_criteria": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "parent_id", "position"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "parent_id": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" }
            ]
          },
          "position": { "type": "integer", "minimum": 0, "maximum": 19 }
        }
      }
    },
    "excluded": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "notes": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  }
}
